.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

/* 指引 */
.guide-card {
  background: #F6F9F7;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.guide-item {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.7;
}

/* 列表项 */
.item-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.item-hospital {
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.tag-auto {
  background: #FDF3E5;
  color: #D98A1F;
}

.thumbs {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.ops {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.op-btn {
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.op-btn.approve {
  background: #2E9E6B;
  color: #fff;
}

.op-btn.reject {
  border: 2rpx solid #C94F4F;
  color: #C94F4F;
}

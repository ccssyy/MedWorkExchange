page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F6F7F9;
}

.ctx-bar {
  padding: 12rpx 24rpx;
  background: #EFF5F3;
  font-size: 22rpx;
  text-align: center;
  flex-shrink: 0;
}

.chat-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ctx-title {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-link {
  color: #999;
  flex-shrink: 0;
  text-decoration: underline;
}

.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.load-more {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.msg-row.mine {
  align-items: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.bubble-other {
  background: #ffffff;
  border-top-left-radius: 4rpx;
}

.bubble-mine {
  background: #0F6E56;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.msg-time {
  font-size: 20rpx;
  margin-top: 8rpx;
}

.list-bottom {
  height: 20rpx;
}

.input-bar {
  flex-shrink: 0;
  background: #ffffff;
  border-top: 1rpx solid #E5E8E7;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.input-row {
  display: flex;
  align-items: center;
}

.input-field {
  flex: 1;
  background: #F2F4F3;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: #C4CFCB;
  color: #ffffff;
  font-size: 28rpx;
}

.send-ready {
  background: #0F6E56;
}

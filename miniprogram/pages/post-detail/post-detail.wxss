.page-wrap {
  padding-bottom: 140rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E1F5EE;
  color: #0F6E56;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.post-meta {
  flex: 1;
  min-width: 0;
}

.post-author {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 2rpx;
}

.delete-btn {
  font-size: 24rpx;
  color: #9AA8A4;
}

.post-title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.post-content {
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.post-img {
  width: 208rpx;
  height: 208rpx;
  border-radius: 12rpx;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #F1F4F2;
  padding-top: 16rpx;
}

.like-btn {
  font-size: 28rpx;
  color: #7A8B87;
}

.like-btn.liked {
  color: #D4537E;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin: 8rpx 0 16rpx;
  padding: 0 8rpx;
}

.comment-card {
  display: flex;
  gap: 16rpx;
}

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E6F1FB;
  color: #185FA5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.comment-author {
  font-size: 25rpx;
  font-weight: 500;
}

.comment-content {
  font-size: 27rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.reply-to {
  color: #185FA5;
  margin-right: 6rpx;
}

.comment-ops {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.op {
  font-size: 23rpx;
  color: #7A8B87;
}

.op-del {
  color: #9AA8A4;
}

.replies {
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-top: 4rpx;
}

.reply {
  padding: 8rpx 0;
}

.reply-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EDF1EF;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
}

.replying-tip {
  font-size: 22rpx;
  color: #185FA5;
  margin-bottom: 8rpx;
}

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-field {
  flex: 1;
  background: #F6F7F9;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
}

.send-btn {
  background: #0F6E56;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 36rpx;
}

.mode-switch {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #5F6E6A;
  background: #F1F5F3;
}

.mode-btn-active {
  background: #0F6E56;
  color: #ffffff;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F4F2;
}

.form-col {
  padding: 20rpx 0;
}

.form-label {
  width: 110rpx;
  color: #5F6E6A;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
}

.form-value {
  flex: 1;
  text-align: right;
  color: #1F2A26;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.compliance {
  padding: 8rpx 16rpx 24rpx;
  line-height: 1.8;
}

.submit-btn {
  margin-top: 16rpx;
}

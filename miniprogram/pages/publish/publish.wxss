.mode-switch {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #5F6E6A;
  background: #F1F5F3;
}

.mode-btn-active {
  background: #0F6E56;
  color: #ffffff;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F4F2;
}

.form-col {
  padding: 20rpx 0;
}

.form-label {
  width: 110rpx;
  color: #5F6E6A;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
}

.form-value {
  flex: 1;
  text-align: right;
  color: #1F2A26;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.compliance {
  padding: 8rpx 16rpx 24rpx;
  line-height: 1.8;
}

.submit-btn {
  margin-top: 16rpx;
}

.time-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F4F2;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.time-value {
  background: #F6F7F9;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 25rpx;
  color: #1F2A26;
}

.time-block .text-hint {
  margin-top: 8rpx;
}

.fee-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.fee-unit {
  font-size: 30rpx;
  color: #993C1D;
  margin-right: 8rpx;
  font-weight: 500;
}

.fee-input {
  width: 200rpx;
  text-align: right;
}

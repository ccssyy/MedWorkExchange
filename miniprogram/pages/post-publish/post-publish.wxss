.section-label {
  font-size: 26rpx;
  color: #5F6E6A;
  margin-bottom: 16rpx;
}

.topic-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.topic-pill {
  background: #F1F5F3;
  color: #5F6E6A;
  font-size: 25rpx;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.topic-active {
  background: #0F6E56;
  color: #FFFFFF;
}

.privacy-tip {
  background: #FCEBEB;
  color: #A32D2D;
  font-size: 23rpx;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.form-col {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #5F6E6A;
  display: block;
  margin-bottom: 12rpx;
}

.title-input {
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.content-textarea {
  width: 100%;
  min-height: 240rpx;
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}

.image-block {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.img-thumb {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.img-inner {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  border: 1rpx dashed #D3D1C7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-plus {
  font-size: 48rpx;
  color: #B4B2A9;
  font-weight: 300;
  line-height: 1;
}

.img-count {
  font-size: 20rpx;
  color: #9AA8A4;
  margin-top: 4rpx;
}

.identity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 27rpx;
}

.identity-opts {
  display: flex;
  gap: 12rpx;
}

.identity-opt {
  font-size: 24rpx;
  color: #5F6E6A;
  background: #F1F5F3;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
}

.identity-on {
  background: #E1F5EE;
  color: #0F6E56;
  font-weight: 500;
}

.risk-tip {
  background: #FCEBEB;
  color: #A32D2D;
  font-size: 23rpx;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 24rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

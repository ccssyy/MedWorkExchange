.empty {
  text-align: center;
  padding: 120rpx 0;
}

.conv {
  display: flex;
  align-items: flex-start;
}

.conv-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #0F6E56;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.conv-info {
  flex: 1;
  min-width: 0;
}

.conv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-title {
  font-size: 30rpx;
  font-weight: 500;
}

.conv-time {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.conv-last {
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.conv-dealing {
  margin-top: 6rpx;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.conv-unread .conv-title {
  font-weight: 600;
}

.unread-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E54D42;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

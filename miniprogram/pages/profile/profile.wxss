.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #0F6E56;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.verify-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.verify-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F4F2;
  font-size: 29rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.disclaimer {
  padding: 24rpx 8rpx;
  line-height: 1.7;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.info-card .title {
  font-size: 34rpx;
  font-weight: 500;
  margin: 12rpx 0 16rpx;
}

.info-row {
  display: flex;
  font-size: 27rpx;
  margin-bottom: 10rpx;
}

.info-label {
  width: 90rpx;
  color: #7A8B87;
  flex-shrink: 0;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-published   { background: #F1EFE8; color: #5F5E5A; }
.status-applied     { background: #E6F1FB; color: #185FA5; }
.status-confirmed   { background: #E1F5EE; color: #0F6E56; }
.status-in_progress { background: #FAEEDA; color: #854F0B; }
.status-completed   { background: #EDF1EF; color: #5F6E6A; }
.status-cancelled   { background: #F1EFE8; color: #9AA8A4; }
.status-disputed    { background: #FCEBEB; color: #A32D2D; }
.status-apply-pending  { background: #E6F1FB; color: #185FA5; }
.status-apply-accepted { background: #E1F5EE; color: #0F6E56; }
.status-apply-rejected { background: #F1EFE8; color: #9AA8A4; }
.status-apply-cancelled { background: #F1EFE8; color: #9AA8A4; }

.cross-card {
  background: #FAF6ED;
  color: #854F0B;
  font-size: 26rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin: 8rpx 0 16rpx;
}

.applicant {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E1F5EE;
  color: #0F6E56;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.applicant-info {
  flex: 1;
  min-width: 0;
}

.applicant-name {
  font-size: 29rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.applicant-msg {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.accept-btn {
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  color: #7A8B87;
  font-size: 26rpx;
}

.confirmed-tip {
  background: #E1F5EE;
  color: #0F6E56;
  font-size: 26rpx;
  line-height: 1.6;
}

.apply-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.apply-textarea {
  width: 100%;
  min-height: 100rpx;
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.my-apply-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.my-apply-status {
  font-size: 27rpx;
}

.cancel-btn {
  background: #FFFFFF;
  color: #7A8B87;
  border: 1rpx solid #D3D1C7;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.compliance {
  padding: 16rpx 8rpx 40rpx;
  line-height: 1.7;
}

.owner-ops {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F4F2;
}

.op-edit {
  font-size: 26rpx;
  color: #0F6E56;
  padding: 8rpx 28rpx;
  border: 1rpx solid #0F6E56;
  border-radius: 999rpx;
}

.op-offshelf {
  font-size: 26rpx;
  color: #A32D2D;
  padding: 8rpx 28rpx;
  border: 1rpx solid #E5B4B4;
  border-radius: 999rpx;
}

.edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.edit-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  text-align: center;
}

.edit-field {
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 25rpx;
  color: #5F6E6A;
  display: block;
  margin-bottom: 10rpx;
}

.edit-input {
  background: #F8FAF9;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 27rpx;
}

.edit-fee-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-fee-wrap .edit-input {
  flex: 1;
}

.edit-time-row {
  display: flex;
  gap: 16rpx;
}

.edit-time-value {
  background: #F8FAF9;
  border-radius: 10rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #1F2A26;
}

.edit-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #F8FAF9;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.edit-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.edit-cancel {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #F1F5F3;
  color: #5F6E6A;
  font-size: 28rpx;
}

.edit-save {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #0F6E56;
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 履约流程操作区（M3） */
.flow-card {
  border-left: 6rpx solid #0F6E56;
}

.flow-tip {
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.flow-btn {
  width: 100%;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.info-card .title {
  font-size: 34rpx;
  font-weight: 500;
  margin: 12rpx 0 16rpx;
}

.info-row {
  display: flex;
  font-size: 27rpx;
  margin-bottom: 10rpx;
}

.info-label {
  width: 90rpx;
  color: #7A8B87;
  flex-shrink: 0;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-published   { background: #F1EFE8; color: #5F5E5A; }
.status-applied     { background: #E6F1FB; color: #185FA5; }
.status-confirmed   { background: #E1F5EE; color: #0F6E56; }
.status-in_progress { background: #FAEEDA; color: #854F0B; }
.status-completed   { background: #EDF1EF; color: #5F6E6A; }
.status-cancelled   { background: #F1EFE8; color: #9AA8A4; }
.status-disputed    { background: #FCEBEB; color: #A32D2D; }
.status-apply-pending  { background: #E6F1FB; color: #185FA5; }
.status-apply-accepted { background: #E1F5EE; color: #0F6E56; }
.status-apply-rejected { background: #F1EFE8; color: #9AA8A4; }
.status-apply-cancelled { background: #F1EFE8; color: #9AA8A4; }

.cross-card {
  background: #FAF6ED;
  color: #854F0B;
  font-size: 26rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin: 8rpx 0 16rpx;
}

.applicant {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E1F5EE;
  color: #0F6E56;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.applicant-info {
  flex: 1;
  min-width: 0;
}

.applicant-name {
  font-size: 29rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.applicant-msg {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.accept-btn {
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  color: #7A8B87;
  font-size: 26rpx;
}

.confirmed-tip {
  background: #E1F5EE;
  color: #0F6E56;
  font-size: 26rpx;
  line-height: 1.6;
}

.apply-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.apply-textarea {
  width: 100%;
  min-height: 100rpx;
  background: #F8FAF9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.my-apply-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.my-apply-status {
  font-size: 27rpx;
}

.cancel-btn {
  background: #FFFFFF;
  color: #7A8B87;
  border: 1rpx solid #D3D1C7;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.compliance {
  padding: 16rpx 8rpx 40rpx;
  line-height: 1.7;
}

<view wx:if="{{loading}}" class="empty text-hint">加载中…</view>

<view wx:elif="{{dealing}}" class="container">
  <view class="card info-card">
    <view class="row-head">
      <view class="tag tag-{{dealing.category}}">{{dealing.categoryLabel}}</view>
      <view class="status-badge status-{{dealing.status}}">{{dealing.statusLabel}}</view>
    </view>
    <view class="title">{{dealing.title}}</view>
    <view class="info-row" wx:if="{{dealing.schedule}}">
      <text class="info-label">时段</text>
      <text>{{dealing.schedule}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">酬金</text>
      <text class="text-fee">{{dealing.feeLabel}}</text>
    </view>
    <view class="info-row" wx:if="{{dealing.detail}}">
      <text class="info-label">说明</text>
      <text>{{dealing.detail}}</text>
    </view>
    <view class="owner-ops" wx:if="{{isOwner && dealing.status !== 'cancelled'}}">
      <view class="op-edit" wx:if="{{canEdit}}" bindtap="onEditTap">编辑</view>
      <view class="op-offshelf" wx:if="{{dealing.status === 'published' || dealing.status === 'applied'}}" bindtap="onOffShelfTap">下架</view>
    </view>
  </view>

  <!-- 履约流程操作区（双方可见） -->
  <view class="card flow-card" wx:if="{{canOperateFlow}}">
    <block wx:if="{{dealing.status === 'confirmed'}}">
      <view class="flow-tip text-secondary">已锁定，请线下沟通到岗细节；开始履约后可确认完成</view>
      <button class="btn-primary flow-btn" bindtap="onStartService">开始履约</button>
    </block>
    <block wx:elif="{{dealing.status === 'in_progress'}}">
      <view class="flow-tip text-secondary" wx:if="{{isOwner && dealing.completeRequested}}">
        {{dealing.acceptedNickname || '对方'}} 已申请确认完成，请核实后确认
      </view>
      <view class="flow-tip text-secondary" wx:elif="{{!isOwner && myCompleteRequested}}">
        已提交完成申请，等待发布方确认
      </view>
      <view class="flow-tip text-secondary" wx:else>履约中，完成后请确认（酬金请线下结清）</view>
      <button
        wx:if="{{!(isOwner && dealing.completeRequested) && !(!isOwner && myCompleteRequested)}}"
        class="btn-primary flow-btn" bindtap="onCompleteService"
      >{{isOwner ? '确认完成' : '申请确认完成'}}</button>
      <button
        wx:if="{{isOwner && dealing.completeRequested}}"
        class="btn-primary flow-btn" bindtap="onConfirmComplete"
      >确认完成</button>
    </block>
    <block wx:elif="{{dealing.status === 'completed'}}">
      <view class="flow-tip text-secondary">已完成，酬金请线下与对方结清</view>
    </block>
  </view>

  <!-- 互评卡（completed 后双方各评一次） -->
  <view class="card review-card" wx:if="{{canOperateFlow && dealing.status === 'completed'}}">
    <view class="section-title">互评</view>
    <block wx:if="{{!myReview}}">
      <view class="stars">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star {{item <= reviewRating ? 'star-on' : ''}}"
          data-star="{{item}}"
          bindtap="onStarTap"
        >★</text>
        <text class="text-hint star-hint">{{reviewRating}} 分</text>
      </view>
      <textarea
        class="review-textarea"
        placeholder="评价内容（选填，100 字内）"
        value="{{reviewContent}}"
        bindinput="onReviewInput"
        maxlength="100"
      />
      <button class="btn-primary review-btn" disabled="{{reviewSubmitting}}" bindtap="onSubmitReview">
        {{reviewSubmitting ? '提交中…' : '提交评价'}}
      </button>
    </block>
    <block wx:else>
      <view class="review-done">
        我已评分：<text class="star-on">{{myReview.rating}} 星</text>
        <text wx:if="{{myReview.content}}" class="text-secondary">「{{myReview.content}}」</text>
      </view>
    </block>
    <view wx:if="{{receivedReview}}" class="review-received text-hint">
      对方评价：{{receivedReview.rating}} 星{{receivedReview.from ? '（' + receivedReview.from + '）' : ''}}
    </view>
  </view>

  <view wx:if="{{crossHospital}}" class="card cross-card">
    该撮合单属于其他医院，仅可浏览，不能申请
  </view>

  <block wx:if="{{isOwner}}">
    <view class="section-title" wx:if="{{dealing.status === 'applied'}}">
      申请人（{{applications.length}}）
    </view>
    <view class="card applicant" wx:for="{{applications}}" wx:key="_id">
      <view class="avatar">{{item.nickname[0]}}</view>
      <view class="applicant-info">
        <view class="applicant-name">{{item.nickname}}</view>
        <view class="text-hint">信用 {{item.credit}} · 已完成 {{item.completed}} 次</view>
        <view class="text-secondary applicant-msg" wx:if="{{item.message}}">留言：{{item.message}}</view>
      </view>
      <button
        wx:if="{{item.status === 'pending'}}"
        class="btn-primary accept-btn"
        size="mini"
        data-id="{{item._id}}"
        bindtap="onAccept"
      >确认</button>
      <view wx:elif="{{item.status === 'accepted'}}" class="tag">已选定</view>
      <view wx:elif="{{item.status === 'rejected'}}" class="text-hint">已拒绝</view>
    </view>

    <view class="card empty-tip" wx:if="{{dealing.status === 'published'}}">
      已发布，等待他人申请…
    </view>

    <view class="card confirmed-tip" wx:if="{{dealing.status === 'confirmed'}}">
      已选定 {{dealing.acceptedNickname || '对方'}}，请线下沟通履约，完成后到「我的-我的发布」确认完成
    </view>
  </block>

  <block wx:else>
    <view class="card apply-card" wx:if="{{!myApplication && !crossHospital && (dealing.status === 'published' || dealing.status === 'applied')}}">
      <textarea
        class="apply-textarea"
        placeholder="给发布方留言（如：同科室，时间合适）"
        value="{{applyMessage}}"
        bindinput="onApplyMessageInput"
        maxlength="100"
      />
      <button class="btn-primary apply-btn" disabled="{{applying}}" bindtap="onApply">
        {{applying ? '申请中…' : '申请接单'}}
      </button>
    </view>

    <view class="card my-apply-card" wx:if="{{myApplication}}">
      <view class="my-apply-status">
        我的申请：
        <text class="status-badge status-apply-{{myApplication.status}}">
          {{myApplication.status === 'pending' ? '等待确认' : myApplication.status === 'accepted' ? '已通过' : myApplication.status === 'rejected' ? '未通过' : '已取消'}}
        </text>
      </view>
      <button
        wx:if="{{myApplication.status === 'pending'}}"
        class="cancel-btn"
        size="mini"
        bindtap="onCancelApply"
      >取消申请</button>
    </view>

    <view class="card confirmed-tip" wx:if="{{myApplication && myApplication.status === 'accepted'}}">
      申请已通过，请到「消息」与对方沟通履约细节
    </view>
  </block>

  <view class="text-hint compliance">
    酬金由双方线下直接结清，平台不代收代付；换班需遵守所在医院相关规定。
  </view>
</view>

<view wx:else class="empty text-hint">撮合单不存在</view>

<view wx:if="{{editOpen}}" class="edit-mask" bindtap="onEditClose">
  <view class="edit-panel" catchtap="onEditNoop">
    <view class="edit-title">编辑撮合单</view>

    <view class="edit-field">
      <text class="edit-label">标题</text>
      <input class="edit-input" value="{{editTitle}}" bindinput="onEditTitleInput" maxlength="30" />
    </view>

    <view class="edit-field">
      <text class="edit-label">酬金</text>
      <view class="edit-fee-wrap">
        <text class="fee-unit">￥</text>
        <input class="edit-input" type="digit" value="{{editFee}}" bindinput="onEditFeeInput" />
      </view>
    </view>

    <view class="edit-field">
      <text class="edit-label">开始</text>
      <view class="edit-time-row">
        <picker mode="date" value="{{editStartDate}}" bindchange="onEditStartDateChange">
          <view class="edit-time-value">{{editStartDate || '选日期'}}</view>
        </picker>
        <picker mode="time" value="{{editStartTime}}" bindchange="onEditStartTimeChange">
          <view class="edit-time-value">{{editStartTime}}</view>
        </picker>
      </view>
    </view>

    <view class="edit-field">
      <text class="edit-label">结束</text>
      <view class="edit-time-row">
        <picker mode="date" value="{{editEndDate}}" bindchange="onEditEndDateChange">
          <view class="edit-time-value">{{editEndDate || '选日期'}}</view>
        </picker>
        <picker mode="time" value="{{editEndTime}}" bindchange="onEditEndTimeChange">
          <view class="edit-time-value">{{editEndTime}}</view>
        </picker>
      </view>
    </view>

    <view class="edit-field">
      <text class="edit-label">说明</text>
      <textarea class="edit-textarea" value="{{editDetail}}" bindinput="onEditDetailInput" maxlength="500" />
    </view>

    <view class="edit-btns">
      <view class="edit-cancel" bindtap="onEditClose">取消</view>
      <view class="edit-save" bindtap="onEditSave">{{editSaving ? '保存中…' : '保存'}}</view>
    </view>
  </view>
</view>
